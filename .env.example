# Contact form email delivery (see src/lib/contactSubmission.ts).
#
# This site is frontend-only (no backend server), so email is sent via
# EmailJS (https://www.emailjs.com) -- a service built specifically for
# sending mail from client-side code. Its "Public Key" is meant to ship in
# the browser bundle (it only authorizes the one service/template pair
# below, unlike an SMTP password or private API secret) so it is safe to
# put in a Vite VITE_-prefixed variable. Never put an SMTP password, the
# EmailJS *Private* Key, or any other secret in a VITE_ variable -- every
# VITE_ value is embedded in the public JavaScript bundle.
#
# To enable email delivery:
#   1. Create a free account at https://www.emailjs.com
#   2. Add an email service (e.g. connect bhattidivyaraj5@gmail.com)
#   3. Create an email template. The form sends these template variables:
#        {{subject}}       "New Portfolio Inquiry — <name>"  (use as Subject)
#        {{message}}       the full inquiry in one block: name, number, city,
#                          state, country, selected services, message
#                          (simplest body: just {{message}})
#      ...and each field on its own, for a field-by-field layout instead:
#        {{from_name}}     Name
#        {{from_phone}}    Number
#        {{from_city}}     City
#        {{from_state}}    State
#        {{from_country}}  Country
#        {{services}}      Selected services, comma-separated
#        {{user_message}}  Message
#      plus:
#        {{to_email}}      bhattidivyaraj5@gmail.com (use as "To Email", or
#                          type the address directly into that field)
#      The form does not collect the visitor's email address, so leave the
#      template's "Reply To" field empty (do not set it to {{from_phone}}).
#   4. Copy .env.example to .env (never commit .env) and fill in:
#        Service ID   -> Email Services page
#        Template ID  -> Email Templates page
#        Public Key   -> Account > General
#   5. Rebuild (npm run build) -- Vite bakes these values in at build time,
#      so a deployed site needs them set in the hosting provider's build
#      environment as well.
#
# Until all three are set, submitting the contact form shows the
# "Something went wrong" retry state -- the form intentionally never claims
# success without a real EmailJS response.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
